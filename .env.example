# The address people open. Sign-in and cookies depend on this being exact.
PUBLIC_URL=https://inventory.uwvexu.ca
WEB_PORT=2210

# Pick a long password and keep it only on the server.
POSTGRES_PASSWORD=

# From the GitHub OAuth app. See DEPLOY.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=UW-VexU

# Optional Cloudflare Tunnel, same as the Workspace tool:
# docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d
CLOUDFLARE_TUNNEL_TOKEN=
