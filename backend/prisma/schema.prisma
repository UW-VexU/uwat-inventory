generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String       @id @default(cuid())
  githubId   Int          @unique
  login      String
  name       String?
  avatarUrl  String?
  createdAt  DateTime     @default(now())
  sessions   Session[]
  events     StockEvent[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model OAuthState {
  stateHash String   @id
  expiresAt DateTime
}

model Box {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String?
  createdAt DateTime @default(now())
  bags      Bag[]
}

model Part {
  id            String       @id @default(cuid())
  partNumber    String?      @unique
  mfrPartNumber String?
  description   String
  category      String       @default("Other")
  package       String?
  minQty        Int?
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bags          Bag[]
  events        StockEvent[]
  placements    Placement[]

  @@index([mfrPartNumber])
}

/// One physical bag. A part can sit in several, and its total is the sum of them.
model Bag {
  id         String       @id @default(cuid())
  partId     String
  part       Part         @relation(fields: [partId], references: [id])
  boxId      String?
  box        Box?         @relation(fields: [boxId], references: [id], onDelete: SetNull)
  quantity   Int
  project    String?
  /// Part, order and quantity from the barcode. Not unique: it only warns about a repeat scan.
  labelKey   String?
  /// Reserved for the Phase 2 NFC tag on this bag.
  tagUid     String?      @unique
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  events     StockEvent[]

  @@index([partId])
  @@index([boxId])
  @@index([labelKey])
}

enum EventType {
  TAKE
  ADD
  COUNT
  INTAKE
  REMOVE
  MOVE
  UNDO
}

model StockEvent {
  id            String       @id @default(cuid())
  type          EventType
  bagId         String
  bag           Bag          @relation(fields: [bagId], references: [id])
  partId        String
  part          Part         @relation(fields: [partId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  delta         Int
  quantityAfter Int
  /// The box at the time, so history stays true after a bag moves.
  boxCode       String?
  note          String?
  /// Sent by the client so a retried request isn't applied twice.
  requestId     String?      @unique
  undoOfId      String?      @unique
  undoOf        StockEvent?  @relation("Undo", fields: [undoOfId], references: [id])
  undoneBy      StockEvent?  @relation("Undo")
  createdAt     DateTime     @default(now())

  @@index([partId, createdAt])
  @@index([createdAt])
}

/// A PCB design, built from its gerbers. Tells people where each part goes.
model Board {
  id            String      @id @default(cuid())
  name          String
  revision      String      @default("")
  widthMm       Float
  heightMm      Float
  topSvg        String
  bottomSvg     String
  schematic     Bytes?
  schematicType String?
  createdAt     DateTime    @default(now())
  placements    Placement[]

  @@unique([name, revision])
}

/// One spot on a board, like R12. x and y are mm from the top-left of the top view.
model Placement {
  id            String  @id @default(cuid())
  boardId       String
  board         Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  ref           String
  side          String
  x             Float
  y             Float
  pads          Json
  packageGuess  String?
  partId        String?
  part          Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)
  /// From the BOM. Kept so the part links itself if it's added to stock later.
  value         String?
  bomDescription String?
  bomPartNumber String?
  bomMfrNumber  String?
  /// The BOM says to leave this spot empty.
  dnp           Boolean @default(false)

  @@unique([boardId, ref])
  @@index([partId])
  @@index([bomPartNumber])
  @@index([bomMfrNumber])
}
